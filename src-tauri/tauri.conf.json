{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Markart",
  "version": "0.1.3",
  "identifier": "com.markart.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Markart",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 26
        },
        "hiddenTitle": true,
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/themes/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "role": "Editor",
        "mimeType": "text/markdown",
        "contentTypes": [
          "net.daringfireball.markdown"
        ]
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQkY2RjBCMDczNTUwQwpSV1FNVlhPdzhQYkxEdHJ6N1IvMFNpVzlmN3NibWhldjA5V1g2Qlh0dUpiQVJ6dWtndUE1MUlZOAo=",
      "endpoints": [
        "https://github.com/Chikomago/Markart/releases/latest/download/latest.json"
      ]
    }
  }
}
